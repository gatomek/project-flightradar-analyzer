<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="
                    http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <changeSet id="20260806_1200" author="TGL">

        <createSequence schemaName="radar_eventsaver" sequenceName="flightevent_id_seq" startValue="1" incrementBy="1"/>

        <createTable schemaName="radar_eventsaver" tableName="flightevent">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="icao" type="varchar2(16)">
                <constraints nullable="false"/>
            </column>
            <column name="startlogid" type="bigint">
                <constraints nullable="true"
                             foreignKeyName="fk_flightevent_startlogid"
                             references="radar_eventsaver.event(id)"/>
            </column>
            <column name="endlogid" type="bigint">
                <constraints nullable="true"
                             foreignKeyName="fk_flightevent_endlogid"
                             references="radar_eventsaver.event(id)"/>
            </column>
            <column name="comment" type="varchar2(100)">
                <constraints nullable="true"/>
            </column>
            <column name="timestamp" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="flightevent" indexName="flightevent_icao_idx" schemaName="radar_eventsaver">
            <column name="icao"/>
        </createIndex>

        <createIndex tableName="flightevent" indexName="flightevent_startlogid_idx" schemaName="radar_eventsaver">
            <column name="startlogid"/>
        </createIndex>

        <createIndex tableName="flightevent" indexName="flightevent_endlogid_idx" schemaName="radar_eventsaver">
            <column name="endlogid"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
